{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentSkillsCatalogSchema",
  "type": "object",
  "required": ["version", "skills"],
  "properties": {
    "version": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "type",
          "source",
          "reviewStatus",
          "description",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "development",
              "architecture",
              "devops",
              "documentation",
              "memory",
              "frontend",
              "testing",
              "database",
              "workflow",
              "planning",
              "security",
              "ai-engineering"
            ]
          },
          "type": {
            "type": "string",
            "enum": ["skill", "toolkit", "integration", "tool_integration"]
          },
          "source": {
            "type": "string",
            "enum": ["builtin", "community"]
          },
          "reviewStatus": {
            "type": "string",
            "enum": ["BUILTIN", "COMMUNITY_REVIEWED", "COMMUNITY_UNREVIEWED"]
          },
          "repository": {
            "type": "string"
          },
          "skillPath": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "lastVerified": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string"
          },
          "reviewNotes": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "maintainer": {
            "type": "string"
          },
          "compatibility": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "reason"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["DUPLICATE", "OVERLAP", "CONFLICT", "INCOMPATIBLE"]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendedFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "popularity": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
